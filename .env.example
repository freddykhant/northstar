# Copy to .env and fill in. Never commit real values.

# Neon Postgres connection string
STORAGE_DATABASE_URL=
# Random secret used by Better Auth to sign sessions
BETTER_AUTH_SECRET=
# Public base URL of the API (e.g. https://northstar-one.vercel.app)
BETTER_AUTH_URL=
# Google OAuth client id
GOOGLE_CLIENT_ID=
# Google OAuth client secret
GOOGLE_CLIENT_SECRET=
# GitHub OAuth client id
GITHUB_CLIENT_ID=
# GitHub OAuth client secret
GITHUB_CLIENT_SECRET=
# Oldest CLI version the API accepts (defaults to 0.0.0)
MIN_CLI_VERSION=
